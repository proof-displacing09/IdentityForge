{
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "description": "IdentityForge — OAuth/OIDC Authentication Attack Laboratory (research console frontend). Synthetic lab data only.",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "25.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "name": "identityforge-frontend",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "preview:docker": "vite preview --host 0.0.0.0 --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:screenshots": "playwright test e2e/screenshots.spec.ts"
  },
  "type": "module",
  "version": "1.8.5",
  "overrides": {
    "picomatch": "npm:@ryotsu/picomatch@4.0.7-a"
  }
}
