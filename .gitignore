# IdentityForge .gitignore — never commit runtime secrets, lab state, or
# build artefacts. The release archive must contain source + docs only.

# --- Secrets / local config -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
id_rsa*
id_ed25519*
**/secrets/
**/*secret*.json

# --- Runtime state ----------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.log
*.zip
*.tar.gz
*.bak
*.swp
*Zone.Identifier

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# --- Node / frontend --------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Playwright / test artefacts --------------------------------------------
test-results/
playwright-report/
playwright/.cache/
coverage/

# --- Docker / Keycloak runtime state ----------------------------------------
keycloak/data/
.docker/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# Local troubleshooting backups
*-backup
